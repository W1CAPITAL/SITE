{
  "name": "zapfast-cloudflare-web",
  "main": "src/index.js",
  "compatibility_date": "2026-09-23",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "define": {
    "globalThis.process.getBuiltinModule": "undefined"
  },
  "rules": [
    {
      "type": "CompiledWasm",
      "globs": [
        "**/*.wasm"
      ],
      "fallthrough": false
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "WA",
        "class_name": "WaSession"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "WaSession"
      ]
    }
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  }
}
